# Copy to .env for local runs (never commit .env)

# GitHub (fine-grained PAT: repo Contents read/write)
GH_FINE_GRAINED_PAT=
GH_REPO=owner/linkedin-auto-post-scheduler

# Telegram — Post Bot
TELEGRAM_POST_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=

# Telegram — Log Bot
TELEGRAM_LOG_BOT_TOKEN=
TELEGRAM_LOG_CHAT_ID=

# Webhook verification (Worker + setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=

# LinkedIn (Worker + Actions as needed)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=
