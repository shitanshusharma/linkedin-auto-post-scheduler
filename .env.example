# Copy to .env for local runs (never commit .env)

# GitHub Models — PAT with `models` scope, or run: gh auth token
GITHUB_TOKEN=

# Optional: model id (default openai/gpt-4o-mini)
# GITHUB_MODEL=openai/gpt-4o-mini

# GitHub (fine-grained PAT: repo Contents read/write) — optional for local git push
GH_FINE_GRAINED_PAT=
GH_REPO=owner/linkedin-auto-post-scheduler

# Telegram — Post Bot
TELEGRAM_POST_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=

# Telegram — Log Bot
TELEGRAM_LOG_BOT_TOKEN=
TELEGRAM_LOG_CHAT_ID=

# Webhook verification (Worker + setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=

# LinkedIn (Worker + Actions as needed)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=
